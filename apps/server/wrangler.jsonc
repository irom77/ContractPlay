{
  "name": "contractplay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "vars": {
    "AUTH_PUBLIC_ORIGIN": "https://contractplay.niuk.workers.dev",
    "AUTH_EMAIL_PROVIDER": "resend",
    "AUTH_EMAIL_FROM": "ContractPlay <signin@romaniuk.us>"
  },
  // Deployment setup: docs/platform-delivery.md#email-sign-in-prerequisites
  // Resend sender domain romaniuk.us is verified; RESEND_API_KEY is a Worker secret.
  // Cloudflare arbitrary-recipient delivery needs Workers Paid + an onboarded sending domain:
  // add send_email: [{ name: "EMAIL" }]. No provider API secret is needed for this binding.
  // Otherwise omit EMAIL, set AUTH_EMAIL_PROVIDER=resend, and store RESEND_API_KEY as a Worker secret.
  // EMAIL takes precedence; a failed Cloudflare send does not retry through Resend.
  // Set BENCHMARK_ADMIN_ACCOUNT_IDS as a Worker secret or in ignored local .dev.vars.
  // Supply comma-separated accounts.id values. With no allowlist, signed-in users cannot administer benchmarks.
  // Local .dev.vars may override AUTH_PUBLIC_ORIGIN=http://localhost:8787 and
  // AUTH_ALLOW_INSECURE_LOCALHOST=true. Never enable insecure cookies for remote hosts.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin"]
  },
  // Production auth database created in Cloudflare; keep this binding aligned with that DB.
  "d1_databases": [
    { "binding": "DB", "database_name": "contractplay-auth", "database_id": "fb6cbdfd-a347-4771-a29a-582f52ff96f2", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableObject" },
      { "name": "LOBBY", "class_name": "LobbyObject" },
      { "name": "SESSIONS", "class_name": "SessionObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableObject", "LobbyObject"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionObject"] }
  ]
}
